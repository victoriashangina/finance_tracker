DEBUG=True
# Empty locally means SQLite. Docker Compose sets PostgreSQL automatically.
DATABASE_URL=
SECRET_KEY=
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=
# Set these for password recovery on the internet. Local links go to the terminal.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=hello@example.com
